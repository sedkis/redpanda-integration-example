# Copy to .env (compose reads it automatically). Defaults work out of the box
# with the LOCAL model — no API key required.

# --- LLM backend: local Ollama (default) ---
OLLAMA_SERVER=http://ollama:11434
# Decent classifier model
OLLAMA_MODEL=llama3.2:3b

# --- LLM backend: hosted drop-in (only used by connect/enrich.hosted.yaml) ---
# Swap the enrich service's config file to this for a fast, no-CPU demo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- pipeline tuning ---
MIN_BYTE_DELTA=50          # skip edits whose |byte change| is below this, before spending a token
CONFIDENCE_THRESHOLD=0.7   # below this (or vandalism/spam) -> trigger the diff-enrichment second pass

# --- infra ---
POSTGRES_USER=wiki
POSTGRES_PASSWORD=wiki
POSTGRES_DB=wiki
