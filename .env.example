# Copy to .env (compose reads it automatically). Defaults work out of the box
# with the LOCAL model — no API key required.

# --- LLM backend: local Ollama (default) ---
OLLAMA_SERVER=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b   # the classifier model — an LLM standing in for the supervised
                           # model a production system would fit on labeled diffs (Tradeoff #1)

# --- infra ---
GRAFANA_PORT=3000          # host port for the dashboard; change if 3000 is taken (e.g. a dev server)
POSTGRES_USER=wiki
POSTGRES_PASSWORD=wiki
POSTGRES_DB=wiki
